# Free key from https://www.themoviedb.org/settings/api
# Required for trending movie and TV posters. AniList anime/manga need no key.
EXPO_PUBLIC_TMDB_API_KEY=

# Supabase project (Project Settings > API) used for login.
# Use the project URL and the publishable (anon) key, never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
